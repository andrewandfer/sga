<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1000.0" styleClass="login-root" stylesheets="@../styles/login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <HBox>

        <!-- ============ LADO IZQUIERDO: MARCA ============ -->
        <StackPane maxWidth="400.0" minWidth="400.0" prefWidth="400.0" styleClass="left-panel">

            <!-- Círculos decorativos de fondo -->
            <Pane mouseTransparent="true">
                <Circle layoutX="40.0" layoutY="90.0" radius="190.0" styleClass="deco-circle" />
                <Circle layoutX="370.0" layoutY="610.0" radius="150.0" styleClass="deco-circle" />
                <Circle layoutX="340.0" layoutY="70.0" radius="60.0" styleClass="deco-circle-soft" />
            </Pane>

            <VBox alignment="CENTER_LEFT" spacing="26.0">

                <padding>
                    <Insets bottom="40.0" left="48.0" right="40.0" top="40.0" />
                </padding>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Marca -->
                <VBox spacing="2.0">
                    <Label styleClass="brand-kicker" text="APARTA-SUITES" />
                    <Label styleClass="brand-title" text="UQ" />
                    <Region maxHeight="4.0" maxWidth="56.0" minHeight="4.0" minWidth="56.0" prefHeight="4.0" prefWidth="56.0" styleClass="accent-line" />
                </VBox>

                <!-- Tarjeta de mensaje -->
                <VBox spacing="10.0" styleClass="glass-card">
                    <Label styleClass="card-title" text="Tu estancia, nuestra prioridad" wrapText="true" />
                    <Label styleClass="card-text" text="Un espacio diseñado para ofrecer comodidad, tranquilidad y una experiencia inolvidable en el corazón del Quindío." wrapText="true" />
                </VBox>

                <!-- Ventajas -->
                <VBox spacing="16.0">

                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                        <Label alignment="CENTER" styleClass="feature-badge" text="✓" />
                        <VBox spacing="1.0">
                            <Label styleClass="feature-title" text="Atención personalizada" />
                            <Label styleClass="feature-text" text="Te acompañamos en cada paso" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                        <Label alignment="CENTER" styleClass="feature-badge" text="✓" />
                        <VBox spacing="1.0">
                            <Label styleClass="feature-title" text="Comodidad y tranquilidad" />
                            <Label styleClass="feature-text" text="Apartamentos completos y privados" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                        <Label alignment="CENTER" styleClass="feature-badge" text="✓" />
                        <VBox spacing="1.0">
                            <Label styleClass="feature-title" text="Experiencia en Salento" />
                            <Label styleClass="feature-text" text="En el corazón del Eje Cafetero" />
                        </VBox>
                    </HBox>

                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Label styleClass="brand-footer" text="SISTEMA DE GESTIÓN DE ALOJAMIENTO" />

            </VBox>

        </StackPane>

        <!-- ============ LADO DERECHO: LOGIN ============ -->
        <VBox alignment="CENTER" spacing="30.0" styleClass="right-panel" HBox.hgrow="ALWAYS">

            <padding>
                <Insets bottom="35.0" left="60.0" right="60.0" top="40.0" />
            </padding>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Encabezado -->
            <VBox alignment="CENTER" maxWidth="380.0" spacing="8.0">
                <Label styleClass="welcome-title" text="Bienvenido" />
                <Label styleClass="welcome-subtitle" text="Ingresa tus credenciales para continuar" />
            </VBox>

            <!-- Formulario -->
            <VBox maxWidth="380.0" prefWidth="380.0" spacing="18.0">

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="Usuario" />
                    <TextField fx:id="usernameField" promptText="Ingresa tu usuario" styleClass="input-field" />
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="field-label" text="Contraseña" />
                    <PasswordField fx:id="passwordField" promptText="Ingresa tu contraseña" styleClass="input-field" />
                </VBox>

                <Label fx:id="errorLabel" minHeight="18.0" styleClass="error-label" wrapText="true" />

                <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" styleClass="login-button" text="Iniciar sesión" />

                <!-- Separador con texto -->
                <HBox alignment="CENTER" spacing="12.0">
                    <Separator HBox.hgrow="ALWAYS" />
                    <Label styleClass="divider-text" text="¿No tienes una cuenta todavía?" />
                    <Separator HBox.hgrow="ALWAYS" />
                </HBox>

                <Button fx:id="registerButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleRegister" styleClass="register-button" text="Crear cuenta de huésped" />

            </VBox>

            <!-- Pie -->
            <VBox alignment="CENTER" spacing="4.0">
                <Label styleClass="footer-brand" text="Aparta-Suites UQ" />
                <Label styleClass="footer-text" text="Salento, Quindío · Colombia" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

        </VBox>

    </HBox>

</StackPane>
