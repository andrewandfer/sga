<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../styles/buscarAlojamiento.css"
            styleClass="dashboard-root">

    <!-- MENU LATERAL -->
    <left>
        <VBox prefWidth="255.0" styleClass="sidebar" spacing="25.0">

            <VBox spacing="4.0">
                <Label text="APARTA-SUITES" styleClass="brand-small"/>
                <Label text="UQ" styleClass="brand-title"/>
                <Label text="EXPERIENCIA DE ALOJAMIENTO"
                       styleClass="brand-caption"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="MENÚ PRINCIPAL" styleClass="menu-heading"/>

                <Button text="⌂    Inicio"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="⌕    Buscar alojamiento"
                        maxWidth="Infinity"
                        styleClass="nav-button nav-active"/>

                <Button text="▤    Mis reservas"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="♡    Favoritos"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="◷    Historial"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="♙    Mi perfil"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="help-card" spacing="8.0">
                <Label text="¿Necesitas ayuda?"
                       styleClass="help-title"/>

                <Label text="Estamos aquí para acompañarte durante tu estancia."
                       wrapText="true"
                       styleClass="help-description"/>

                <Button text="Contactar"
                        styleClass="help-button"/>
            </VBox>

            <Button text="↪    Cerrar sesión"
                    maxWidth="Infinity"
                    styleClass="logout-button"/>

            <Label text="SALENTO · QUINDÍO · COLOMBIA"
                   styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="content-scroll">

            <VBox spacing="24.0" styleClass="main-content">

                <!-- ENCABEZADO -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">

                    <VBox spacing="5.0">
                        <Label text="EXPLORA NUESTROS ESPACIOS"
                               styleClass="eyebrow"/>

                        <Label text="Encuentra tu alojamiento ideal"
                               styleClass="welcome-title"/>

                        <Label text="Selecciona tus fechas y descubre las opciones disponibles."
                               styleClass="welcome-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Label text="MI CUENTA"
                               styleClass="profile-caption"/>

                        <Label text="Huésped"
                               styleClass="profile-name"/>
                    </VBox>
                </HBox>

                <!-- BUSCADOR -->
                <VBox spacing="17.0" styleClass="section-card">

                    <VBox spacing="5.0">
                        <Label text="Busca tu próxima estancia"
                               styleClass="section-title"/>

                        <Label text="Indica las fechas y la cantidad de personas que se alojarán."
                               styleClass="section-description"/>
                    </VBox>

                    <HBox spacing="14.0">

                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="FECHA DE ENTRADA"
                                   styleClass="field-label"/>

                            <DatePicker promptText="Fecha de entrada"
                                        maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="FECHA DE SALIDA"
                                   styleClass="field-label"/>

                            <DatePicker promptText="Fecha de salida"
                                        maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="NÚMERO DE PERSONAS"
                                   styleClass="field-label"/>

                            <TextField promptText="Ej. 4 personas"/>
                        </VBox>

                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">

                        <Label text="ORDENAR RESULTADOS:"
                               styleClass="field-label"/>

                        <ComboBox promptText="Selecciona un criterio"
                                  prefWidth="240.0"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Buscar disponibilidad  →"
                                styleClass="primary-button"/>
                    </HBox>
                </VBox>

                <!-- RESULTADOS DE BUSQUEDA -->
                <VBox spacing="15.0">

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4.0">
                            <Label text="Apartamentos disponibles"
                                   styleClass="section-title"/>

                            <Label text="Consulta las opciones que coincidan con tu búsqueda."
                                   styleClass="section-description"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="RESULTADOS"
                               styleClass="result-caption"/>
                    </HBox>

                    <!-- APARTAMENTO 1 -->
                    <HBox spacing="18.0"
                          styleClass="apartment-card">

                        <VBox alignment="CENTER"
                              styleClass="apartment-placeholder"
                              prefWidth="145.0"
                              minWidth="145.0">

                            <Label text="⌂"
                                   styleClass="apartment-symbol"/>

                            <Label text="APARTAMENTO"
                                   styleClass="placeholder-caption"/>
                        </VBox>

                        <VBox spacing="10.0"
                              HBox.hgrow="ALWAYS">

                            <Label text="Nombre del apartamento"
                                   styleClass="apartment-title"/>

                            <Label text="Código: pendiente de datos"
                                   styleClass="apartment-detail"/>

                            <HBox spacing="18.0">
                                <Label text="Bloque: por consultar"
                                       styleClass="apartment-detail"/>

                                <Label text="Piso: por consultar"
                                       styleClass="apartment-detail"/>
                            </HBox>

                            <HBox spacing="18.0">
                                <Label text="Dormitorios: por consultar"
                                       styleClass="apartment-detail"/>

                                <Label text="Capacidad máxima: por consultar"
                                       styleClass="apartment-detail"/>
                            </HBox>

                            <Label text="Características del apartamento"
                                   styleClass="section-description"
                                   wrapText="true"/>
                        </VBox>

                        <VBox alignment="CENTER_RIGHT"
                              spacing="10.0">

                            <Label text="TARIFA POR PERSONA / NOCHE"
                                   styleClass="field-label"/>

                            <Label text="Pendiente"
                                   styleClass="apartment-price"/>

                            <Button text="Seleccionar"
                                    styleClass="secondary-button"/>
                        </VBox>

                    </HBox>

                    <!-- APARTAMENTO 2 -->
                    <HBox spacing="18.0"
                          styleClass="apartment-card">

                        <VBox alignment="CENTER"
                              styleClass="apartment-placeholder"
                              prefWidth="145.0"
                              minWidth="145.0">

                            <Label text="⌂"
                                   styleClass="apartment-symbol"/>

                            <Label text="APARTAMENTO"
                                   styleClass="placeholder-caption"/>
                        </VBox>

                        <VBox spacing="10.0"
                              HBox.hgrow="ALWAYS">

                            <Label text="Nombre del apartamento"
                                   styleClass="apartment-title"/>

                            <Label text="Código: pendiente de datos"
                                   styleClass="apartment-detail"/>

                            <HBox spacing="18.0">
                                <Label text="Bloque: por consultar"
                                       styleClass="apartment-detail"/>

                                <Label text="Piso: por consultar"
                                       styleClass="apartment-detail"/>
                            </HBox>

                            <HBox spacing="18.0">
                                <Label text="Dormitorios: por consultar"
                                       styleClass="apartment-detail"/>

                                <Label text="Capacidad máxima: por consultar"
                                       styleClass="apartment-detail"/>
                            </HBox>

                            <Label text="Características del apartamento"
                                   styleClass="section-description"
                                   wrapText="true"/>
                        </VBox>

                        <VBox alignment="CENTER_RIGHT"
                              spacing="10.0">

                            <Label text="TARIFA POR PERSONA / NOCHE"
                                   styleClass="field-label"/>

                            <Label text="Pendiente"
                                   styleClass="apartment-price"/>

                            <Button text="Seleccionar"
                                    styleClass="secondary-button"/>
                        </VBox>

                    </HBox>

                </VBox>

                <!-- COTIZACION -->
                <VBox spacing="16.0"
                      styleClass="section-card">

                    <VBox spacing="5.0">
                        <Label text="Cotización de tu estancia"
                               styleClass="section-title"/>

                        <Label text="Consulta el valor de cada noche y el total de tu alojamiento."
                               styleClass="section-description"/>
                    </VBox>

                    <!-- ENCABEZADO DE TABLA -->
                    <HBox styleClass="quote-header"
                          spacing="8.0">

                        <Label text="NOCHE"
                               HBox.hgrow="ALWAYS"/>

                        <Label text="TEMPORADA"
                               HBox.hgrow="ALWAYS"/>

                        <Label text="PERSONAS"
                               HBox.hgrow="ALWAYS"/>

                        <Label text="SUBTOTAL"
                               HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- DESGLOSE DE NOCHES -->
                    <VBox spacing="0.0"
                          styleClass="quote-table">

                        <!-- FILA 1 -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="8.0"
                              styleClass="quote-row">

                            <Label text="Fecha por consultar"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Temporada"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Por consultar"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Por calcular"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell quote-value"/>
                        </HBox>

                        <!-- FILA 2 -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="8.0"
                              styleClass="quote-row">

                            <Label text="Fecha por consultar"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Temporada"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Por consultar"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Por calcular"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell quote-value"/>
                        </HBox>

                        <!-- FILA 3 -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="8.0"
                              styleClass="quote-row">

                            <Label text="Fecha por consultar"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Temporada"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Por consultar"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell"/>

                            <Label text="Por calcular"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="quote-cell quote-value"/>
                        </HBox>

                    </VBox>

                    <Label text="El desglose se adaptará a la cantidad real de noches de la estancia."
                           wrapText="true"
                           styleClass="section-description"/>

                    <!-- RESUMEN DE COTIZACION -->
                    <HBox alignment="CENTER_RIGHT"
                          spacing="20.0">

                        <VBox spacing="4.0"
                              alignment="CENTER_RIGHT">

                            <Label text="TOTAL DE LA ESTANCIA"
                                   styleClass="field-label"/>

                            <Label text="Pendiente de cotización"
                                   styleClass="total-price"/>
                        </VBox>
                    </HBox>

                    <Label text="La cotización se calculará según las tarifas por persona y la temporada de cada noche. Los menores de 6 años ocupan cupo, pero no pagan."
                           wrapText="true"
                           styleClass="section-description"/>

                </VBox>

                <!-- PIE DE PAGINA -->
                <Label text="APARTA-SUITES UQ  ·  SALENTO, QUINDÍO"
                       styleClass="footer-text"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>



