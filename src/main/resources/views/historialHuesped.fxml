
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.HistorialController"
            stylesheets="@../styles/historialHuesped.css"
            styleClass="dashboard-root">

    <left>
        <VBox prefWidth="255.0" styleClass="sidebar" spacing="25.0">

            <VBox spacing="4.0">
                <Label text="APARTA-SUITES" styleClass="brand-small"/>
                <Label text="UQ" styleClass="brand-title"/>
                <Label text="EXPERIENCIA DE ALOJAMIENTO" styleClass="brand-caption"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="MENÚ PRINCIPAL" styleClass="menu-heading"/>
                <Button text="⌂    Inicio" maxWidth="Infinity" styleClass="nav-button" onAction="#irInicio"/>
                <Button text="⌕    Buscar alojamiento" maxWidth="Infinity" styleClass="nav-button" onAction="#irBuscar"/>
                <Button text="▤    Mis reservas" maxWidth="Infinity" styleClass="nav-button" onAction="#irReservas"/>
                <Button text="♡    Favoritos" maxWidth="Infinity" styleClass="nav-button" onAction="#irFavoritos"/>
                <Button text="◷    Historial" maxWidth="Infinity" styleClass="nav-button nav-active" onAction="#irHistorial"/>
                <Button text="♙    Mi perfil" maxWidth="Infinity" styleClass="nav-button" onAction="#irPerfil"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="help-card" spacing="8.0">
                <Label text="¿Necesitas ayuda?" styleClass="help-title"/>
                <Label text="Estamos aquí para acompañarte durante tu estancia."
                       wrapText="true" styleClass="help-description"/>
                <Button text="Contactar" styleClass="help-button" onAction="#contactar"/>
            </VBox>

            <Button text="↪    Cerrar sesión" maxWidth="Infinity" styleClass="logout-button" onAction="#cerrarSesion"/>
            <Label text="SALENTO · QUINDÍO · COLOMBIA" styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox spacing="24.0" styleClass="main-content">

                <!-- ENCABEZADO -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <VBox spacing="5.0">
                        <Label text="TUS EXPERIENCIAS" styleClass="eyebrow"/>
                        <Label text="Historial de estancias" styleClass="welcome-title"/>
                        <Label text="Consulta los alojamientos en los que has disfrutado de tu estancia."
                               wrapText="true" styleClass="welcome-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Label text="MI CUENTA" styleClass="profile-caption"/>
                        <Label fx:id="nombreHuesped" text="Huésped" styleClass="profile-name"/>
                    </VBox>
                </HBox>

                <!-- RESUMEN -->
                <HBox spacing="15.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="summary-card">
                        <Label text="ESTANCIAS FINALIZADAS" styleClass="stat-title"/>
                        <Label fx:id="totalFinalizadas" text="0" styleClass="stat-number"/>
                        <Label text="Alojamientos completados" styleClass="stat-description"/>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="summary-card">
                        <Label text="ÚLTIMA ESTANCIA" styleClass="stat-title"/>
                        <Label fx:id="ultimaEstancia" text="Sin estancias" styleClass="stat-number"/>
                        <Label text="Fecha de la última salida" styleClass="stat-description"/>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" spacing="8.0" styleClass="summary-card">
                        <Label text="NOCHES ALOJADAS" styleClass="stat-title"/>
                        <Label fx:id="totalNoches" text="0" styleClass="stat-number"/>
                        <Label text="Total de noches disfrutadas" styleClass="stat-description"/>
                    </VBox>
                </HBox>

                <!-- FILTROS -->
                <VBox spacing="16.0" styleClass="section-card">
                    <VBox spacing="5.0">
                        <Label text="Consultar historial" styleClass="section-title"/>
                        <Label text="Utiliza los filtros para localizar una estancia."
                               styleClass="section-description"/>
                    </VBox>

                    <HBox spacing="14.0">
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="FECHA DESDE" styleClass="field-label"/>
                            <DatePicker fx:id="fechaDesde" promptText="Fecha inicial"
                                        maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="FECHA HASTA" styleClass="field-label"/>
                            <DatePicker fx:id="fechaHasta" promptText="Fecha final"
                                        maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="ESTADO" styleClass="field-label"/>
                            <ComboBox fx:id="filtroEstado" promptText="Todos los estados"
                                      maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Consultar historial  →"
                                onAction="#consultarHistorial"
                                styleClass="primary-button"/>
                    </HBox>
                </VBox>

                <!-- LISTADO DE ESTANCIAS -->
                <VBox spacing="15.0">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5.0">
                            <Label text="Mis estancias anteriores" styleClass="section-title"/>
                            <Label text="Consulta los detalles de tus reservas anteriores."
                                   styleClass="section-description"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="REGISTRO DE ESTANCIAS" styleClass="result-caption"/>
                    </HBox>

                    <VBox fx:id="contenedorEstancias" spacing="15.0"/>
                </VBox>

                <!-- DETALLE DE LA ESTANCIA -->
                <VBox spacing="15.0" styleClass="section-card">
                    <VBox spacing="5.0">
                        <Label text="Detalle de la estancia" styleClass="section-title"/>
                        <Label text="Consulta el resumen de noches y movimientos asociados a una reserva."
                               styleClass="section-description"/>
                    </VBox>

                    <VBox fx:id="movimientosDetalle" spacing="12.0"
                          visible="false" managed="false">

                        <Label fx:id="codigoDetalle" text="Código de reserva"
                               styleClass="reservation-code"/>

                        <Label fx:id="apartamentoDetalle" text="Apartamento"
                               styleClass="apartment-title"/>

                        <HBox spacing="15.0">
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label text="FECHA DE ENTRADA" styleClass="field-label"/>
                                <Label fx:id="entradaDetalle" text="-" styleClass="stay-detail"/>
                            </VBox>

                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label text="FECHA DE SALIDA" styleClass="field-label"/>
                                <Label fx:id="salidaDetalle" text="-" styleClass="stay-detail"/>
                            </VBox>

                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label text="NOCHES" styleClass="field-label"/>
                                <Label fx:id="nochesDetalle" text="0" styleClass="stay-detail"/>
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                                <Label text="TOTAL DE LA ESTANCIA" styleClass="field-label"/>
                                <Label fx:id="totalDetalle" text="Pendiente"
                                       styleClass="total-price"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="detalleVacio" spacing="8.0"
                          alignment="CENTER" styleClass="empty-detail">
                        <Label text="▤" styleClass="empty-icon"/>
                        <Label text="Selecciona una estancia" styleClass="empty-title"/>
                        <Label text="Aquí podrás consultar los detalles de la estancia seleccionada."
                               wrapText="true" styleClass="empty-description"/>
                    </VBox>
                </VBox>

                <!-- ESTADO VACIO -->
                <VBox fx:id="estadoVacio" spacing="8.0"
                      alignment="CENTER" styleClass="empty-history"
                      visible="false" managed="false">
                    <Label text="◷" styleClass="empty-icon"/>
                    <Label text="Tu historial aparecerá aquí" styleClass="empty-title"/>
                    <Label text="Cuando finalices una estancia, podrás consultar sus detalles en esta sección."
                           wrapText="true" styleClass="empty-description"/>
                </VBox>

                <Label text="APARTA-SUITES UQ  ·  SALENTO, QUINDÍO"
                       styleClass="footer-text"/>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>


