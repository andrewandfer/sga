<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane
        minHeight="600.0"
        minWidth="800.0"
        prefHeight="720.0"
        prefWidth="1000.0"
        styleClass="register-root"
        stylesheets="@../styles/register.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.RegistroController">

    <!-- Fondo decorativo -->
    <Pane mouseTransparent="true">
        <Circle layoutX="60.0" layoutY="80.0"
                radius="210.0" styleClass="deco-circle"/>
        <Circle layoutX="960.0" layoutY="680.0"
                radius="190.0" styleClass="deco-circle"/>
        <Circle layoutX="900.0" layoutY="70.0"
                radius="70.0" styleClass="deco-circle-soft"/>
    </Pane>

    <!-- Contenido desplazable -->
    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                pannable="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="register-scroll">

        <content>
            <VBox alignment="CENTER" spacing="12.0">

                <padding>
                    <Insets top="24.0" bottom="24.0"
                            left="30.0" right="30.0"/>
                </padding>

                <!-- TARJETA -->
                <VBox maxWidth="740.0"
                      prefWidth="740.0"
                      spacing="20.0"
                      styleClass="form-card">

                    <!-- Encabezado -->
                    <VBox alignment="CENTER" spacing="6.0">
                        <Label styleClass="brand-kicker"
                               text="APARTA-SUITES UQ"/>

                        <Region maxHeight="3.0"
                                maxWidth="44.0"
                                minHeight="3.0"
                                minWidth="44.0"
                                styleClass="accent-line"/>

                        <Label styleClass="welcome-title"
                               text="Crear cuenta">
                            <VBox.margin>
                                <Insets top="6.0"/>
                            </VBox.margin>
                        </Label>

                        <Label styleClass="welcome-subtitle"
                               text="Regístrate como huésped de Aparta-Suites UQ"/>
                    </VBox>

                    <!-- DATOS PERSONALES -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="section-title"
                               text="DATOS PERSONALES"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <GridPane hgap="18.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox spacing="6.0"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0">
                            <Label styleClass="field-label" text="Documento *"/>
                            <TextField fx:id="documentField"
                                       promptText="Número de documento"
                                       styleClass="input-field"/>
                        </VBox>

                        <VBox spacing="6.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0">
                            <Label styleClass="field-label" text="Nombre completo *"/>
                            <TextField fx:id="nameField"
                                       promptText="Nombre y apellidos"
                                       styleClass="input-field"/>
                        </VBox>

                        <VBox spacing="6.0"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1">
                            <Label styleClass="field-label" text="Fecha de nacimiento * (mínimo 15 años)"/>
                            <DatePicker fx:id="birthDatePicker"
                                        maxWidth="Infinity"
                                        promptText="dd/mm/aaaa"
                                        styleClass="input-field"/>
                        </VBox>

                        <VBox spacing="6.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1">
                            <Label styleClass="field-label" text="Teléfono"/>
                            <TextField fx:id="phoneField"
                                       promptText="Número de contacto"
                                       styleClass="input-field"/>
                        </VBox>

                        <VBox spacing="6.0"
                              GridPane.columnIndex="0"
                              GridPane.columnSpan="2"
                              GridPane.rowIndex="2">
                            <Label styleClass="field-label"
                                   text="Correo electrónico"/>
                            <TextField fx:id="emailField"
                                       promptText="correo@ejemplo.com"
                                       styleClass="input-field"/>
                        </VBox>
                    </GridPane>

                    <!-- SEGURIDAD -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="section-title" text="SEGURIDAD"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <GridPane hgap="18.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox spacing="6.0"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0">
                            <Label styleClass="field-label" text="Contraseña *"/>
                            <PasswordField fx:id="passwordField"
                                           promptText="Crea una contraseña"
                                           styleClass="input-field"/>
                        </VBox>

                        <VBox spacing="6.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0">
                            <Label styleClass="field-label"
                                   text="Confirmar contraseña *"/>
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Repite tu contraseña"
                                           styleClass="input-field"/>
                        </VBox>
                    </GridPane>

                    <Label fx:id="errorLabel"
                           minHeight="18.0"
                           styleClass="error-label"
                           wrapText="true"/>

                    <!-- BOTONES -->
                    <HBox alignment="CENTER" spacing="14.0">
                        <Button maxWidth="Infinity"
                                minWidth="250.0"
                                prefWidth="250.0"
                                mnemonicParsing="false"
                                onAction="#handleBack"
                                styleClass="register-button"
                                text="Volver al inicio de sesión"/>

                        <Button defaultButton="true"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                onAction="#handleRegister"
                                styleClass="login-button"
                                text="Crear cuenta"
                                HBox.hgrow="ALWAYS"/>
                    </HBox>

                </VBox>

                <!-- PIE -->
                <VBox alignment="CENTER" spacing="2.0">
                    <Label styleClass="page-footer-brand"
                           text="Aparta-Suites UQ"/>
                    <Label styleClass="page-footer-text"
                           text="Salento, Quindío · Colombia"/>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>

</StackPane>
