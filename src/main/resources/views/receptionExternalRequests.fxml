<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefWidth="1440.0" prefHeight="900.0" styleClass="external-root"
            stylesheets="@../styles/receptionExternalRequests.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ReceptionExternalRequestsController">
    <left>
        <VBox prefWidth="238.0" spacing="0.0" styleClass="sidebar">
            <VBox spacing="5.0" styleClass="brand-area">
                <HBox alignment="CENTER_LEFT" spacing="11.0">
                    <Label text="A" styleClass="brand-mark" />
                    <VBox spacing="1.0"><Label text="APARTA-SUITES" styleClass="brand-name"/><Label text="UQ · SALENTO" styleClass="brand-caption"/></VBox>
                </HBox>
            </VBox>
            <Label text="OPERACIÓN" styleClass="nav-section" />
            <VBox spacing="6.0" styleClass="nav-list">
                <Button onAction="#volver" styleClass="nav-item nav-button" maxWidth="Infinity" focusTraversable="false" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-background-radius: 9; -fx-border-color: transparent; -fx-text-fill: #D8E4E5; -fx-padding: 12;"><graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><Label text="▦" styleClass="nav-icon"/><Label text="Calendario semanal" styleClass="nav-text"/></HBox></graphic></Button>
                <Button onAction="#abrirPreparacion" styleClass="nav-item nav-button" maxWidth="Infinity" focusTraversable="false" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-background-radius: 9; -fx-border-color: transparent; -fx-text-fill: #D8E4E5; -fx-padding: 12;"><graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><Label text="✓" styleClass="nav-icon"/><Label text="Preparación" styleClass="nav-text"/></HBox></graphic></Button>
                <HBox styleClass="nav-item nav-item-active" alignment="CENTER_LEFT" spacing="12.0"><Label text="⇄" styleClass="nav-icon"/><Label text="Canal externo" styleClass="nav-text"/></HBox>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="12.0" styleClass="sidebar-bottom">
                <HBox alignment="CENTER_LEFT" spacing="10.0"><Label fx:id="employeeInitialLabel" text="R" styleClass="avatar"/><VBox spacing="2.0" HBox.hgrow="ALWAYS"><Label fx:id="employeeNameLabel" text="Recepción" styleClass="employee-name"/><Label text="Recepcionista" styleClass="employee-role"/></VBox></HBox>
                <Button text="Cerrar sesión" onAction="#logout" styleClass="logout-button" maxWidth="Infinity" />
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="20.0" styleClass="main-content">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="OPERACIÓN · RECEPCIÓN" styleClass="eyebrow"/>
                            <Label text="Solicitudes del canal externo" styleClass="page-title"/>
                            <Label text="Revisa las solicitudes recibidas de terceros y procésalas en orden de llegada (FIFO)." styleClass="page-subtitle" wrapText="true"/>
                        </VBox>
                        <Button text="← Calendario" onAction="#volver" styleClass="secondary-button" style="-fx-background-color: #EEF3F4; -fx-background: #EEF3F4; -fx-text-fill: #31535A;"/>
                        <Button text="Actualizar" onAction="#actualizar" styleClass="secondary-button" style="-fx-background-color: #EEF3F4; -fx-background: #EEF3F4; -fx-text-fill: #31535A;"/>
                    </HBox>
                    <HBox spacing="12.0" styleClass="metrics-row">
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="EN ESPERA" styleClass="metric-caption"/><Label fx:id="pendingCountLabel" text="0" styleClass="metric-value"/><Label text="Solicitudes pendientes" styleClass="metric-footnote"/></VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="ACEPTADAS" styleClass="metric-caption"/><Label fx:id="acceptedCountLabel" text="0" styleClass="metric-value"/><Label text="Reservas creadas" styleClass="metric-footnote"/></VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="RECHAZADAS" styleClass="metric-caption"/><Label fx:id="rejectedCountLabel" text="0" styleClass="metric-value"/><Label text="Con conflicto o validación fallida" styleClass="metric-footnote"/></VBox>
                    </HBox>
                    <HBox spacing="15.0" alignment="TOP_LEFT">
                        <VBox spacing="13.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10.0"><VBox spacing="3.0" HBox.hgrow="ALWAYS"><Label text="Cola de solicitudes" styleClass="section-title"/><Label text="La solicitud más antigua se procesa primero. Recibirla no bloquea noches todavía." styleClass="section-subtitle" wrapText="true"/></VBox><Button fx:id="processNextButton" text="Procesar siguiente" onAction="#procesarSiguiente" styleClass="primary-button" style="-fx-background-color: #17616A; -fx-background: #17616A; -fx-text-fill: white;"/></HBox>
                            <VBox fx:id="pendingList" spacing="9.0"/>
                            <Label fx:id="emptyPendingLabel" text="No hay solicitudes pendientes en la cola." styleClass="empty-message" wrapText="true"/>
                            <Button fx:id="processAllButton" text="Procesar toda la cola FIFO" onAction="#procesarTodas" styleClass="secondary-button" maxWidth="Infinity" style="-fx-background-color: #EEF3F4; -fx-background: #EEF3F4; -fx-text-fill: #31535A;"/>
                        </VBox>
                        <VBox spacing="13.0" styleClass="side-column" HBox.hgrow="ALWAYS">
                            <VBox spacing="10.0" styleClass="panel-card"><Label text="Historial procesado" styleClass="section-title"/><Label text="Solicitudes aceptadas y rechazadas." styleClass="section-subtitle"/><VBox fx:id="historyList" spacing="8.0"/><Label fx:id="emptyHistoryLabel" text="Aún no hay solicitudes procesadas." styleClass="empty-message" wrapText="true"/></VBox>
                            <VBox spacing="10.0" styleClass="panel-card"><Label text="Conflictos detectados" styleClass="section-title"/><Label text="Solicitudes que no pudieron convertirse en reserva." styleClass="section-subtitle"/><VBox fx:id="conflictsList" spacing="8.0"/><Label fx:id="emptyConflictsLabel" text="No se han registrado conflictos." styleClass="empty-message" wrapText="true"/></VBox>
                        </VBox>
                    </HBox>
                    <Label text="El canal externo utiliza una cola FIFO: las solicitudes se evalúan una por una, respetando el orden de recepción. Una solicitud aceptada crea una reserva confirmada; una solicitud con conflicto queda registrada como rechazada." styleClass="footnote" wrapText="true"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
