<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="850.0" prefWidth="1360.0" styleClass="dashboard-root"
            stylesheets="@../styles/adminApartments.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminApartmentsController">
    <left>
        <VBox prefWidth="252.0" spacing="0.0" styleClass="sidebar">
            <VBox spacing="5.0" styleClass="brand-area">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane prefHeight="46.0" prefWidth="46.0" styleClass="brand-icon"><Label styleClass="brand-icon-text" text="A"/></StackPane>
                    <VBox spacing="0.0"><Label styleClass="brand-name" text="APARTA-SUITES"/><Label styleClass="brand-subtitle" text="UQ · SALENTO"/></VBox>
                </HBox>
            </VBox>
            <VBox spacing="8.0" styleClass="sidebar-navigation">
                <Label styleClass="nav-caption" text="MENÚ PRINCIPAL"/>
                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-item" onMouseClicked="#handleDashboard"><Label styleClass="nav-icon" text="⌂"/><Label styleClass="nav-text" text="Dashboard"/></HBox>
                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-item" onMouseClicked="#handleGuests"><Label styleClass="nav-icon" text="♙"/><Label styleClass="nav-text" text="Huéspedes"/></HBox>
                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-item nav-item-active"><Label styleClass="nav-icon" text="▦"/><Label styleClass="nav-text nav-text-active" text="Apartamentos"/></HBox>
                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-item" onMouseClicked="#handleEmployees"><Label styleClass="nav-icon" text="♧"/><Label styleClass="nav-text" text="Empleados"/></HBox>
                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-item" onMouseClicked="#handleSeasons"><Label styleClass="nav-icon" text="◷"/><Label styleClass="nav-text" text="Temporadas"/></HBox>
                <HBox alignment="CENTER_LEFT" spacing="13.0" styleClass="nav-item" onMouseClicked="#handleBuildingMap"><Label styleClass="nav-icon" text="⌖"/><Label styleClass="nav-text" text="Mapa del edificio"/></HBox>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="12.0" styleClass="sidebar-bottom">
                <VBox spacing="5.0" styleClass="help-card"><Label styleClass="help-title" text="Inventario del alojamiento"/><Label styleClass="help-description" text="Administra las unidades, sus características y tarifas por temporada." wrapText="true"/></VBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sidebar-user">
                    <StackPane prefHeight="38.0" prefWidth="38.0" styleClass="avatar-small"><Label fx:id="adminInitialLabel" styleClass="avatar-letter" text="A"/></StackPane>
                    <VBox spacing="2.0"><Label fx:id="adminNameLabel" styleClass="sidebar-user-name" text="Administrador"/><Label styleClass="sidebar-user-role" text="Panel administrativo"/></VBox>
                </HBox>
            </VBox>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="20.0" styleClass="dashboard-content">
                    <padding><Insets top="28.0" right="30.0" bottom="34.0" left="30.0"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS"><Label styleClass="page-eyebrow" text="ADMINISTRACIÓN"/><Label styleClass="page-title" text="Gestión de apartamentos"/><Label styleClass="page-date" text="Controla el inventario y las tarifas de cada unidad."/></VBox>
                        <Button onAction="#handleLogout" styleClass="logout-button" text="Cerrar sesión  ↗"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" styleClass="welcome-banner" spacing="13.0">
                        <StackPane prefHeight="44.0" prefWidth="44.0" styleClass="welcome-symbol"><Label styleClass="welcome-symbol-text" text="⌂"/></StackPane>
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS"><Label styleClass="banner-title" text="Inventario de Aparta-Suites UQ"/><Label styleClass="banner-subtitle" text="Consulta, registra y actualiza las unidades de alojamiento."/></VBox>
                        <Label styleClass="banner-tag" text="ALOJAMIENTO"/>
                    </HBox>
                    <HBox alignment="TOP_LEFT" spacing="18.0">
                        <VBox spacing="13.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT"><VBox spacing="3.0" HBox.hgrow="ALWAYS"><Label styleClass="section-title" text="Apartamentos registrados"/><Label styleClass="section-subtitle" text="Selecciona una unidad para consultar o editar sus datos."/></VBox><Label fx:id="apartmentCountLabel" styleClass="table-count" text="0 APARTAMENTOS"/></HBox>
                            <TextField fx:id="searchField" onKeyReleased="#handleSearch" promptText="Buscar por código, nombre, bloque o estado..." styleClass="input-field"/>
                            <TableView fx:id="apartmentsTable" onMouseClicked="#handleSelectApartment" prefHeight="530.0" styleClass="apartments-table">
                                <columns>
                                    <TableColumn fx:id="codeColumn" prefWidth="90.0" text="Código"/>
                                    <TableColumn fx:id="nameColumn" prefWidth="145.0" text="Nombre"/>
                                    <TableColumn fx:id="blockColumn" prefWidth="75.0" text="Bloque"/>
                                    <TableColumn fx:id="capacityColumn" prefWidth="145.0" text="Capacidad"/>
                                    <TableColumn fx:id="stateColumn" prefWidth="155.0" text="Estado"/>
                                </columns>
                                <placeholder><Label styleClass="empty-table" text="No hay apartamentos para mostrar."/></placeholder>
                            </TableView>
                            <HBox alignment="CENTER_LEFT" spacing="10.0"><Button onAction="#handleDelete" styleClass="danger-button" text="Eliminar seleccionado"/><Region HBox.hgrow="ALWAYS"/><Label styleClass="table-hint" text="La eliminación se bloquea si existen reservas activas."/></HBox>
                        </VBox>
                        <VBox prefWidth="350.0" minWidth="330.0" spacing="13.0" styleClass="panel-card">
                            <VBox spacing="3.0"><Label styleClass="section-title" text="Datos del apartamento"/><Label styleClass="section-subtitle" text="Completa la información de la unidad."/></VBox>
                            <GridPane hgap="10.0" vgap="10.0">
                                <columnConstraints><ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/></columnConstraints>
                                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label styleClass="field-label" text="Código *"/><TextField fx:id="codeField" promptText="Ej. A101" styleClass="input-field"/></VBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label styleClass="field-label" text="Nombre *"/><TextField fx:id="nameField" promptText="Nombre" styleClass="input-field"/></VBox>
                                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label styleClass="field-label" text="Bloque *"/><TextField fx:id="blockField" promptText="Bloque" styleClass="input-field"/></VBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label styleClass="field-label" text="Piso *"/><TextField fx:id="floorField" promptText="0" styleClass="input-field"/></VBox>
                                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2"><Label styleClass="field-label" text="Dormitorios *"/><TextField fx:id="bedroomsField" promptText="2" styleClass="input-field"/></VBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label styleClass="field-label" text="Capacidad *"/><TextField fx:id="capacityField" promptText="4" styleClass="input-field"/></VBox>
                            </GridPane>
                            <VBox spacing="5.0"><Label styleClass="field-label" text="Características"/><TextArea fx:id="featuresField" prefRowCount="2" promptText="Descripción breve de la unidad..." styleClass="input-area" wrapText="true"/></VBox>
                            <Separator styleClass="form-separator"/>
                            <VBox spacing="3.0"><Label styleClass="section-title-small" text="TARIFA POR PERSONA / NOCHE"/><Label styleClass="section-subtitle" text="Valores requeridos para las tres temporadas."/></VBox>
                            <GridPane hgap="9.0" vgap="8.0">
                                <columnConstraints><ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/><ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/></columnConstraints>
                                <VBox spacing="5.0" GridPane.columnIndex="0"><Label styleClass="field-label" text="Baja *"/><TextField fx:id="lowRateField" promptText="0" styleClass="input-field"/></VBox>
                                <VBox spacing="5.0" GridPane.columnIndex="1"><Label styleClass="field-label" text="Media *"/><TextField fx:id="mediumRateField" promptText="0" styleClass="input-field"/></VBox>
                                <VBox spacing="5.0" GridPane.columnIndex="2"><Label styleClass="field-label" text="Alta *"/><TextField fx:id="highRateField" promptText="0" styleClass="input-field"/></VBox>
                            </GridPane>
                            <VBox spacing="5.0"><Label styleClass="field-label" text="Estado operativo"/><ComboBox fx:id="stateComboBox" maxWidth="Infinity" styleClass="input-field"/><Label styleClass="field-label" text="Motivo si está fuera de servicio"/><TextField fx:id="outOfServiceReasonField" promptText="Motivo obligatorio para sacar de servicio" styleClass="input-field"/></VBox>
                            <Label fx:id="messageLabel" minHeight="32.0" styleClass="message-label" wrapText="true"/>
                            <HBox spacing="9.0"><Button onAction="#handleClear" styleClass="secondary-button" text="Limpiar"/><Button maxWidth="Infinity" onAction="#handleSave" styleClass="login-button" text="Guardar apartamento" HBox.hgrow="ALWAYS"/></HBox>
                            <Label styleClass="form-note" text="* Campos obligatorios. Código, dormitorios y capacidad no se modifican después del registro." wrapText="true"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT"><Label styleClass="footer-text" text="APARTA-SUITES UQ  •  INVENTARIO DE ALOJAMIENTO"/></HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
