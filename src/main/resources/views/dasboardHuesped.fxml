<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.HuespedController"
            stylesheets="@/styles/dashboardHuesped.css"
            styleClass="dashboard-root">

    <!-- MENU LATERAL -->
    <left>
        <VBox prefWidth="255.0" styleClass="sidebar" spacing="25.0">

            <VBox spacing="4.0">
                <Label text="APARTA-SUITES"
                       styleClass="brand-small"/>
                <Label text="UQ"
                       styleClass="brand-title"/>
                <Label text="EXPERIENCIA DE ALOJAMIENTO"
                       styleClass="brand-caption"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="MENÚ PRINCIPAL"
                       styleClass="menu-heading"/>

                <Button text="⌂    Inicio"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-active"/>

                <Button text="⌕    Buscar alojamiento"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="▤    Mis reservas"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="♡    Favoritos"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="◷    Historial"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="♙    Mi perfil"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="help-card" spacing="8.0">
                <Label text="¿Necesitas ayuda?"
                       styleClass="help-title"/>
                <Label text="Estamos aquí para acompañarte durante tu estancia."
                       wrapText="true"
                       styleClass="help-description"/>
                <Button text="Contactar"
                        styleClass="help-button"/>
            </VBox>

            <Button text="↪    Cerrar sesión"
                    maxWidth="Infinity"
                    styleClass="logout-button"/>

            <Label text="SALENTO · QUINDÍO · COLOMBIA"
                   styleClass="sidebar-footer"/>

        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="content-scroll">

            <VBox spacing="25.0" styleClass="main-content">

                <!-- ENCABEZADO -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">

                    <VBox spacing="5.0">
                        <Label text="MI ESPACIO"
                               styleClass="eyebrow"/>

                        <Label text="¡Bienvenido!"
                               styleClass="welcome-title"/>

                        <Label text="Tu próxima experiencia comienza aquí."
                               styleClass="welcome-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT" spacing="4.0">
                        <Label text="MI CUENTA"
                               styleClass="profile-caption"/>
                        <Label text="Huésped"
                               styleClass="profile-name"/>
                    </VBox>

                </HBox>

                <!-- BANNER PRINCIPAL -->
                <VBox styleClass="hero-banner" spacing="14.0">

                    <Label text="APARTA-SUITES UQ"
                           styleClass="hero-eyebrow"/>

                    <Label text="Un lugar para descansar,\ndisfrutar y volver."
                           styleClass="hero-title"
                           wrapText="true"/>

                    <Label text="Vive una experiencia única en el corazón del Quindío."
                           styleClass="hero-description"
                           wrapText="true"/>

                    <Button text="Explorar apartamentos  →"
                            styleClass="hero-button"/>

                </VBox>

                <!-- ESTADISTICAS -->
                <VBox spacing="15.0">

                    <Label text="RESUMEN DE MI CUENTA"
                           styleClass="section-heading"/>

                    <HBox spacing="16.0">

                        <VBox HBox.hgrow="ALWAYS"
                              spacing="10.0"
                              styleClass="stat-card">

                            <Label text="▤"
                                   styleClass="stat-icon"/>

                            <Label text="MIS RESERVAS"
                                   styleClass="stat-title"/>

                            <Label text="02"
                                   styleClass="stat-number"/>

                            <Label text="Reservas registradas"
                                   styleClass="stat-description"/>

                        </VBox>

                        <VBox HBox.hgrow="ALWAYS"
                              spacing="10.0"
                              styleClass="stat-card">

                            <Label text="♡"
                                   styleClass="stat-icon"/>

                            <Label text="FAVORITOS"
                                   styleClass="stat-title"/>

                            <Label text="04"
                                   styleClass="stat-number"/>

                            <Label text="Apartamentos guardados"
                                   styleClass="stat-description"/>

                        </VBox>

                        <VBox HBox.hgrow="ALWAYS"
                              spacing="10.0"
                              styleClass="stat-card">

                            <Label text="◷"
                                   styleClass="stat-icon"/>

                            <Label text="HISTORIAL"
                                   styleClass="stat-title"/>

                            <Label text="05"
                                   styleClass="stat-number"/>

                            <Label text="Estancias realizadas"
                                   styleClass="stat-description"/>

                        </VBox>

                    </HBox>
                </VBox>

                <!-- BUSCADOR -->
                <VBox spacing="16.0"
                      styleClass="section-card">

                    <VBox spacing="5.0">
                        <Label text="Encuentra tu próximo destino"
                               styleClass="section-title"/>

                        <Label text="Selecciona tus fechas y descubre nuestros apartamentos."
                               styleClass="section-description"/>
                    </VBox>

                    <HBox spacing="14.0">

                        <VBox spacing="7.0"
                              HBox.hgrow="ALWAYS">
                            <Label text="FECHA DE ENTRADA"
                                   styleClass="field-label"/>
                            <DatePicker promptText="Selecciona fecha"
                                        maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="7.0"
                              HBox.hgrow="ALWAYS">
                            <Label text="FECHA DE SALIDA"
                                   styleClass="field-label"/>
                            <DatePicker promptText="Selecciona fecha"
                                        maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="7.0"
                              HBox.hgrow="ALWAYS">
                            <Label text="NÚMERO DE PERSONAS"
                                   styleClass="field-label"/>
                            <TextField promptText="Ej. 4 personas"/>
                        </VBox>

                    </HBox>

                    <Button text="Buscar disponibilidad  →"
                            styleClass="primary-button"/>

                </VBox>

                <!-- RESERVAS -->
                <VBox spacing="14.0"
                      styleClass="section-card">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4.0">
                            <Label text="Mis próximas reservas"
                                   styleClass="section-title"/>
                            <Label text="Consulta tus próximas experiencias."
                                   styleClass="section-description"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="VER TODAS"
                               styleClass="view-more"/>
                    </HBox>

                    <HBox styleClass="empty-reservations"
                          alignment="CENTER"
                          spacing="15.0">

                        <Label text="▤"
                               styleClass="empty-icon"/>

                        <VBox spacing="5.0">
                            <Label text="Tus próximas estancias aparecerán aquí."
                                   styleClass="empty-title"/>
                            <Label text="Cuando tengas una reserva, podrás consultar todos sus detalles."
                                   styleClass="empty-description"
                                   wrapText="true"/>
                        </VBox>

                    </HBox>

                </VBox>

                <Label text="APARTA-SUITES UQ  ·  SALENTO, QUINDÍO"
                       styleClass="footer-text"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

